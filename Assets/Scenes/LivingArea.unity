--- !u!114 &1855681337
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1855681335}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50defcfea6479224f8ed80a2121ce4db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  thisObject: {fileID: 1855681335}
  backgroundImage: {fileID: 993771612}
  charNameText: {fileID: 341067736}
  dialogueText: {fileID: 75464147}
  characterImage: {fileID: 1537481284}
  nextButton: {fileID: 1286128532}
  dialogueSequence:
  - charName: "\uFF1F\uFF1F\uFF1F"
    dialogueText: "\u2026\u2026"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: a4f81ac323691c64f91420f150d15061, type: 3}
  - charName: "\uFF1F\uFF1F\uFF1F"
    dialogueText: "\u62B1\u6B49\uFF0C\u5FD8\u8BB0\u81EA\u6211\u4ECB\u7ECD\u4E86\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 8b552a7d3e3018f4bb1e650610307bbb, type: 3}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u6211\u53EB\u6D1B\u5E93\u65AF\uFF0C\u662F\u8D1F\u8D23\u751F\u6D3B\u533A\u7684RHO\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\uFF08\u8FD9\u5C31\u662F\u201CRHO\u201D\uFF1F\uFF09"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 8451c27d08dfc0d45af4eba376a1f6e6, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\uFF08\u786E\u8BA4\u4E66\u4E2D\u6709\u63D0\u5230\u201CRHO\u57FA\u4E8E\u771F\u5B9E\u5B58\u5728\u8FC7\u7684\u4EBA\u6784\u5EFA\uFF0C\u4F46\u5E76\u975E\u4ED6\u4EEC\u672C\u4EBA\u201D\u8FD9\u6837\u7684\u8BDD\uFF0C\u6211\u4EE5\u4E3A\u2026\u2026\u662F\u6709\u9884\u8BBE\u7A0B\u5E8F\u7684\u5168\u606F\u6295\u5F71\u4E00\u7C7B\u3002\uFF09"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 8451c27d08dfc0d45af4eba376a1f6e6, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\uFF08\u7136\u800C\uFF0C\u773C\u524D\u8FD9\u4E2A\u4EBA\u7684\u5B58\u5728\u611F\u662F\u5982\u6B64\u771F\u5B9E\uFF0C\u65E0\u8BBA\u662F\u4ED6\u62AC\u5934\u65F6\u8863\u7269\u7684\u8F7B\u5FAE\u6469\u64E6\u58F0\uFF0C\u8FD8\u662F\u4ED6\u5634\u89D2\u90A3\u62B9\u81EA\u7136\u7684\u7B11\u610F\uFF0C\u90FD\u65E0\u6CD5\u5C06\u4ED6\u4E0E\u865A\u65E0\u7684\u6295\u5F71\u8054\u7CFB\u5728\u4E00\u8D77\u3002\uFF09"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 8451c27d08dfc0d45af4eba376a1f6e6, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\uFF08\u7A76\u7ADF\u662F\u4F55\u79CD\u6280\u672F\uFF0C\u80FD\u591F\u8BA9\u201C\u975E\u4EBA\u201D\u7684\u5B58\u5728\uFF0C\u62E5\u6709\u5982\u6B64\u903C\u771F\u7684\u201C\u4EBA\u6027\u201D\uFF1F\uFF09"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 8451c27d08dfc0d45af4eba376a1f6e6, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u6D1B\u5E93\u65AF\u5148\u751F\u2026\u2026\u60A8\u597D\u3002\u6211\u662F\u51DB\u3002\u662F\u201C\u900F\u955C\u884C\u52A8\u201D\u7684\u5FD7\u613F\u8005\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u51DB\u2026\u2026\u771F\u662F\u4E00\u4E2A\u4E0D\u9519\u7684\u540D\u5B57\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 572beb9f774dda04bb8dd7d64ed165a2, type: 3}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u6211\u5728\u4F8B\u884C\u5DE1\u67E5\u65F6\u770B\u5230\u4F60\u5012\u5728\u5165\u53E3\u5904\uFF0C\u5C31\u628A\u4F60\u5E26\u5230\u8FD9\u91CC\u6765\u4E86\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u770B\u6765\u4F60\u662F\u521A\u5F00\u59CB\u6267\u884C\u4EFB\u52A1\u5427\uFF1F\u6211\u5DF2\u7ECF\u628A\u751F\u6D3B\u533A\u7684\u5730\u56FE\u5BFC\u5165\u4F60\u7684\u8BBE\u5907\u4E86\u3002\u6253\u5F00\u4E3B\u5C4F\uFF0C\u5728\u201C\u5730\u56FE\u201D\u83DC\u5355\u91CC\u5C31\u80FD\u770B\u5230\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u5982\u679C\u6267\u884C\u4EFB\u52A1\u671F\u95F4\u9047\u5230\u4EC0\u4E48\u95EE\u9898\uFF0C\u53EF\u4EE5\u968F\u65F6\u6765\u8FD9\u91CC\uFF0C\u4E5F\u5C31\u662FRHO\u529E\u516C\u5BA4\u627E\u6211\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u8C22\u8C22\uFF0C\u6211\u660E\u767D\u4E86\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 062a4dc97d68da94785d4f0d929639ff, type: 3}
  typingSpeed: 0.05
  backgroundTransition: {fileID: 1778154193}
  backgroundFadeDuration: 0.3
