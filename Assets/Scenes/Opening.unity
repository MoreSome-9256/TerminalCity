  dialogueText: {fileID: 1593383978}
  characterImage: {fileID: 174025793}
  nextButton: {fileID: 697086897}
  dialogueSequence:
  - charName: "\u51DB/Lyn"
    dialogueText: "\u4FE1\u606F\u6709\u4E9B\u591A\u5462\u2026\u2026\u5927\u6982\u662F\u8BF4\uFF0C\u6211\u9700\u8981\u901A\u8FC7\u6536\u96C6\u548C\u62FC\u51D1\u4FE1\u606F\u6765\u8FD8\u539F\u8BA4\u77E5\uFF0C\u4E5F\u5C31\u662F\u5173\u4E8E\u201CTC\u201D\u7684\u5386\u53F2\u4E4B\u7C7B\u7684\uFF1F"
    characterSprite: {fileID: 21300000, guid: e3d95248cb2c5904b9b325d90d83d689, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u4E0D\u8FC7\u5982\u8D44\u6599\u4E0A\u6240\u8BF4\uFF0C\u5173\u4E8E\u4EFB\u52A1\u7684\u7EC6\u8282\u63A5\u4E0B\u6765\u4F1A\u6709\u8BE6\u7EC6\u6307\u5F15\uFF0C\u5E94\u8BE5\u4E0D\u7528\u592A\u62C5\u5FC3\u3002"
    characterSprite: {fileID: 21300000, guid: 4de41ec9fb2c3bf4c8946ac0892b562b, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u6240\u4EE5\uFF0C\u6211\u73B0\u5728\u4EC0\u4E48\u90FD\u4E0D\u8BB0\u5F97\uFF0C\u662F\u8BA4\u77E5\u91CD\u5851\u9879\u76EE\u6267\u884C\u7684\u8BB0\u5FC6\u4E34\u65F6\u6E05\u9664\u6240\u81F4\uFF1F\r"
    characterSprite: {fileID: 94769929, guid: 8894ca2e12f597940bf1009692b5df17, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u4F46\u662F\u90A3\u53E5\u8BDD\u2026\u2026\u6211\u786E\u5B9E\u6709\u5370\u8C61\uFF0C\u5C31\u5728\u521A\u521A\u7684<b>\u68A6</b>\u4E2D\u3002"
    characterSprite: {fileID: 94769929, guid: 8894ca2e12f597940bf1009692b5df17, type: 3}
  - charName: "\u51DB/Lyn"
    dialogueText: "\u90A3\u4E48\u6240\u8C13\u7684<b>\u68A6</b>\u5C31\u662F\uFF0C<b>\u8FC7\u53BB\u7684\u6211</b>\u6240\u7559\u4E0B\u7684\u5BC6\u94A5\u2014\u2014"
    characterSprite: {fileID: 21300000, guid: e3d95248cb2c5904b9b325d90d83d689, type: 3}
  typingSpeed: 0.05
