--- !u!114 &1490701389
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1490701387}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50defcfea6479224f8ed80a2121ce4db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  thisObject: {fileID: 1490701387}
  backgroundImage: {fileID: 1184987475}
  charNameText: {fileID: 1463395690}
  dialogueText: {fileID: 2008697479}
  characterImage: {fileID: 491059277}
  nextButton: {fileID: 655069749}
  dialogueSequence:
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "\u6240\u4EE5\u4F60\u7684\u610F\u601D\u662F\uFF0C\u76EE\u524D\u900F\u955C\u884C\u52A8\u5DF2\u8FDB\u884C\u7684\u51E0\u8F6E\u8FD8\u539F\u6027\u9012\u51CF\uFF0C\u662F\u56E0\u4E3A\u7F3A\u4E00\u4E2A\u4EBA\uFF1F"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u5973\uFF09"
    dialogueText: "\u6050\u6015\u662F\u8FD9\u6837\u3002\u6211\u4EEC\u5FFD\u7565\u4E86\u81EA\u8EAB\u8BA4\u77E5\u5BF9\u900F\u955C\u7684\u5F71\u54CD\uFF0C\u5BFC\u81F4\u6C42\u5F97\u7684\u6240\u9700\u4EBA\u6570\u6BD4\u5B9E\u9645\u503C\u5C0F1\u3002"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "\u4F46\u662F\uFF0C<b>\u51DB</b>\xB7\xB7\xB7\xB7\xB7\xB7\u6216\u8BB8\u8FD8\u6709\u522B\u7684\u529E\u6CD5\u3002"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u6050\u6015\u6765\u4E0D\u53CA\u4E86\u3002"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "<b>PHN</b>\u5DF2\u7ECF\u542F\u52A8\uFF0C\u73B0\u5728\u53EA\u5269\u4E0B\xB7\xB7\xB7\xB7\xB7\xB7"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\xB7\xB7\xB7\xB7\xB7\xB7"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u8BF7\u8BA9\u6211\u4EB2\u81EA\u6765\u5427\u3002"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "\u4F60\u77E5\u9053\u8FD9\u610F\u5473\u7740\u4EC0\u4E48\u3002"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u6211\u5DF2\u7ECF\u4E0D\u5728\u4E4E\u4E86\u3002\u53EA\u5E0C\u671B\u8DDF\u4ED6\u4EEC\u76F8\u6BD4\xB7\xB7\xB7\xB7\xB7\xB7\u6211\u8FD8\u7B97\u591F\u683C\uFF1F"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "\u5F53\u4F60\u505A\u51FA\u8FD9\u6837\u7684\u51B3\u5B9A\uFF0C\u5C31\u5DF2\u7ECF\u7B26\u5408\u8981\u6C42\u4E86\u3002"
    characterSprite: {fileID: 0}
  - charName: "\uFF1F\uFF1F\uFF1F\uFF08\u7537\uFF09"
    dialogueText: "\u53EA\u662F\u8FD9\u5BF9\u4F60\u6765\u8BF4\u2014\u2014\uFF08\u88AB\u6253\u65AD\uFF09"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u8FD9\u79CD\u8BDD\u4ECE\u8C01\u53E3\u4E2D\u8BF4\u51FA\u6765\u6211\u90FD\u4F1A\u76F8\u4FE1\uFF0C\u552F\u72EC\u4F60\u9664\u5916\uFF0C<b>\u79D1\u65AF\u9ED8</b>\u3002"
    characterSprite: {fileID: 0}
  - charName: "\u79D1\u65AF\u9ED8"
    dialogueText: "\xB7\xB7\xB7\xB7\xB7\xB7"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u7B97\u4E86\uFF0C\u6211\u77E5\u9053\u4F60\u4E5F\u5DF2\u7ECF\u5C3D\u529B\u4E86\u3002\u73B0\u5728\u6211\u80FD\u5BF9\u4F60\u8BF4\u7684\uFF0C\u6050\u6015\u53EA\u6709\u90A3\u53E5\u4F60\u66FE\u542C\u8FC7\u65E0\u6570\u6B21\u7684\u8BDD\u2014\u2014"
    characterSprite: {fileID: 0}
  - charName: "\u51DB"
    dialogueText: "\u4E0D\u8981\u8BA9\u6211\u5931\u671B\uFF0C\u4E0D\u8981\u8BA9\u5927\u5BB6\u5931\u671B\uFF0C\u4E0D\u8981\xB7\xB7\xB7\xB7\xB7\xB7\u8BA9<b>\u5979</b>\u5931\u671B\u3002"
