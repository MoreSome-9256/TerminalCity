  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u7406\u8BBA\u4E0A\u662F\u7684\u3002\u4F46\u6D1B\u5E0C\uFF0C\u4F60\u80FD\u4FDD\u8BC1\u4ECE\u4ECA\u5F80\u540E\u7684TC\u2026\u2026\u4E0D\u4F1A\u518D\u51FA\u73B0\u7B2C\u4E8C\u4E2A\u4F0A\u8299\u7433\u5417\uFF1F"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 873765654, guid: ab8aa9ca00d82154d85da777c02a6265, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\uFF01\uFF01"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: -935693930, guid: ab8aa9ca00d82154d85da777c02a6265, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u2026\u2026\u5BF9\u4E0D\u8D77\uFF0C\u90FD\u662F\u56E0\u4E3A\u6211\u2026\u2026"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 1826178589, guid: ab8aa9ca00d82154d85da777c02a6265, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u4E0D\uFF0C\u8FD9\u548C\u201C\u8C01\u7684\u8D23\u4EFB\u201D\u65E0\u5173\u3002"
    leftSprite: {fileID: 1000428102, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 503880309, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u80FD\u529B\u8005\u662F\u5BA2\u89C2\u5B58\u5728\u7684\uFF0C\u65E0\u8BBA\u6709\u6CA1\u6709\u4EBA\u4E3A\u5E72\u9884\uFF0C\u90FD\u53EF\u80FD\u51FA\u73B0\u201C\u4F0A\u8299\u7433\u4E8B\u4EF6\u201D\u3002\u5B83\u5B8C\u5168\u5728\u6211\u4EEC\u7684\u610F\u6599\u548C\u7406\u89E3\u4E4B\u5916\uFF0C\u7528\u5E38\u89C4\u65B9\u6CD5\u8FDB\u884C\u9632\u8303\uFF0C\u53EF\u80FD\u6027\u4E3A\u96F6\u3002"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 503880309, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u53EA\u6709\u540C\u6837\u7684\u201C\u4E0D\u53EF\u7406\u89E3\u4E4B\u4E8B\u201D\uFF0C\u624D\u80FD\u8BA9\u4EBA\u7C7B\u5728\u9762\u5BF9\u540C\u6837\u7684\u707E\u96BE\u65F6\uFF0C\u62E5\u6709\u6D3B\u4E0B\u53BB\u7684\u7B79\u7801\u3002"
    leftSprite: {fileID: -759375375, guid: c5aa1bb1898864d46945f0e44bf4fdb6, type: 3}
    rightSprite: {fileID: 503880309, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u5C31\u50CFIris\u7684\u201C\u5947\u8FF9\u201D\u6551\u4E86\u6211\u4EEC\u2026\u2026\u603B\u6709\u4E00\u5929\uFF0C\u6211\u4EEC\u4E5F\u4F1A\u9700\u8981\u7EC8\u7AEF\u8FD9\u4E2A\u201C\u5947\u8FF9\u201D\u3002"
    leftSprite: {fileID: 74074794, guid: c5aa1bb1898864d46945f0e44bf4fdb6, type: 3}
    rightSprite: {fileID: 503880309, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u7EC8\u7AEF\u4E0D\u662F\u5947\u8FF9\uFF0C\u7F57\u5C14\u3002\u5B83\u662F\u9B54\u9B3C\u7684\u5951\u7EA6\u3002\u6211\u4EEC\u62E5\u6709\u4E86\u4E00\u65F6\u7684\u201C\u5FC3\u60F3\u4E8B\u6210\u201D\uFF0C\u4F46\u4EE3\u4EF7\u53EF\u80FD\u662F\u96BE\u4EE5\u4F30\u91CF\u7684\u626D\u66F2\u3002\u800C\u4E14\u4E00\u65E6\u5F00\u59CB\u2014\u2014\u6211\u4EEC\u5C31\u518D\u4E5F\u505C\u4E0D\u4E0B\u6765\u4E86\u3002"
    leftSprite: {fileID: -1477617346, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 63456223, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u6B63\u56E0\u5982\u6B64\uFF0C\u6211\u4EEC\u624D\u9700\u8981\u63A7\u5236\u5B83\u3002\u7EC8\u7AEF\u662F\u4E00\u4E2A\u673A\u5236\uFF0C\u4E00\u4E2A\u5DE5\u5177\u3002\u5DE5\u5177\u672C\u8EAB\u6CA1\u6709\u5584\u6076\uFF0C\u53D6\u51B3\u4E8E\u4F7F\u7528\u8005\u3002\u5982\u679C\u6211\u4EEC\u5FC5\u987B\u62E5\u6709\u5B83\uFF0C\u90A3\u4E48\u6211\u4EEC\u5C31\u5FC5\u987B\u786E\u4FDD\u5B83\u88AB\u7528\u5728\u6700\u6B63\u786E\u7684\u65F6\u5019\uFF0C\u88AB\u6700\u6B63\u786E\u7684\u4EBA\u4F7F\u7528\u3002"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 63456223, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u2026\u2026"
    leftSprite: {fileID: -1518550134, guid: c5aa1bb1898864d46945f0e44bf4fdb6, type: 3}
    rightSprite: {fileID: 63456223, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u4F60\u662F\u6700\u4F73\u4EBA\u9009\uFF0C\u6D1B\u5E93\u65AF\u3002"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 63456223, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u2026\u2026\u4EC0\u4E48\uFF1F"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: -2097434369, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u7EC8\u7AEF\u7684\u7528\u6237\u3002\u9996\u8111\u3002\u552F\u4E00\u6709\u6743\u9650\u4E0B\u8FBE\u6307\u4EE4\u7684\u4EBA\u3002\u4F60\u5584\u826F\uFF0C\u5171\u60C5\uFF0C\u88AB\u6240\u6709\u4EBA\u7231\u6234\u3002\u4F60\u4F1A\u662F\u6700\u8C28\u614E\u3001\u6700\u8D1F\u8D23\u4EFB\u7684\u4F7F\u7528\u8005\u3002\u4F60\u4F1A\u628A\u5B83\u5F53\u4F5C\u6700\u540E\u7684\u624B\u6BB5\uFF0C\u800C\u4E0D\u662F\u4FBF\u5229\u7684\u5DE5\u5177\u3002"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: -2097434369, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u7F57\uFF0C\u4F60\u770B\u6211\u3002\u6211\u8FDE\u2026\u2026\u6211\u8FDE\u4E00\u4E2A\u5C0F\u5B69\u5B50\u7684\u68C0\u6D4B\u62A5\u544A\u90FD\u4E0D\u6562\u5982\u5B9E\u586B\u5199\u3002\u6211\u5BB3\u6B7B\u4E86\u6574\u4E2A\u4E16\u754C\u3002\u4F60\u73B0\u5728\u8981\u6211\u6210\u4E3A\u8FD9\u4E2A\u2026\u2026\u8FD9\u4E2A\u673A\u5668\u7684\u795E\uFF1F"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 1867623966, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u4F60\u4E0D\u662F\u795E\uFF0C\u4F60\u53EA\u662F\u7AD9\u5728\u6700\u524D\u9762\u7684\u4EBA\uFF0C\u771F\u6B63\u88AB\u5386\u53F2\u8BB0\u4F4F\u3001\u88AB\u795D\u798F\u7684\u90A3\u4E00\u4E2A\u3002"
    leftSprite: {fileID: 2137904136, guid: 76327f27619f6f34a85bb25a0c70576d, type: 3}
    rightSprite: {fileID: 1730035580, guid: ab8aa9ca00d82154d85da777c02a6265, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u2026\u2026"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 484038800, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u5373\u4F7F\u4F60\u8BF4\u5F97\u5BF9\uFF0C\u5373\u4F7F\u6211\u4EEC\u5FC5\u987B\u771F\u7684\u4F7F\u7528\u5B83\uFF0C\u90A3\u4E2A\u4EBA\u2026\u2026\u4E5F\u4E0D\u8BE5\u662F\u6211\u3002"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 1852605487, guid: 2dc860c3a2ff40849944ed209390aa86, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u6BCF\u5929\u5E26\u7740\u8FD9\u4E2A\u6743\u9650\u6D3B\u7740\uFF0C\u77E5\u9053\u6211\u53EF\u4EE5\u8F7B\u6613\u6539\u53D8\u4EFB\u4F55\u4E8B\uFF0C\u5374\u53C8\u5FC5\u987B\u5047\u88C5\u4E0D\u80FD\u2026\u2026\u6211\u4F1A\u75AF\u7684\u3002"
    leftSprite: {fileID: -574157945, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 1852605487, guid: 2dc860c3a2ff40849944ed209390aa86, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 0
    charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u6211\u77E5\u9053\u3002\u4F46\u6211\u6CA1\u6709\u522B\u4EBA\u53EF\u4EE5\u6258\u4ED8\u4E86\u3002\u5982\u679C\u6211\u4EEC\u5FC5\u987B\u8981\u6709\u4E00\u4E2A\u4EBA\u6765\u627F\u62C5\u8FD9\u4E00\u5207\uFF0C\u6211\u5E0C\u671B\u662F\u4F60\u3002\u56E0\u4E3A\u6211\u77E5\u9053\uFF0C\u4F60\u6BD4\u4EFB\u4F55\u4EBA\u90FD\u75DB\u82E6\uFF0C\u6240\u4EE5\u4F60\u4F1A\u6BD4\u4EFB\u4F55\u4EBA\u90FD\u514B\u5236\u3002"
    leftSprite: {fileID: -1518550134, guid: c5aa1bb1898864d46945f0e44bf4fdb6, type: 3}
    rightSprite: {fileID: -482200289, guid: a703198d5d9f38c4eaf47ea7e0d01781, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u4E0D\u2026\u2026\u50CF\u6211\u8FD9\u79CD\u4F18\u67D4\u5BE1\u65AD\u7684\u4EBA\uFF0C\u662F\u65E0\u6CD5\u6210\u4E3AUser\u7684\u3002"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: 2089818281, guid: 2dc860c3a2ff40849944ed209390aa86, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u56E0\u4E3A\u75DB\u82E6\u4E0D\u80FD\u5236\u9020\u6B63\u786E\uFF0C\u5171\u60C5\u4E0D\u80FD\u66FF\u4EE3\u51B3\u65AD\u3002\u771F\u6B63\u9002\u5408\u6210\u4E3AUser\u7684\u662F\u2026\u2026\u629B\u4E0B\u4E00\u5207\uFF0C\u679C\u65AD\u9009\u62E9\u7684\u4EBA\u3002"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: -107986924, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u4F46\u628A\u8FD9\u4E2A\u4F4D\u7F6E\u4EA4\u51FA\u53BB\uFF0C\u672C\u8EAB\u5C31\u5DF2\u7ECF\u662F\u7F6A\u4E86\u3002"
    leftSprite: {fileID: -83695204, guid: 7c9d791e800bd224c8eabc89ac757cc1, type: 3}
    rightSprite: {fileID: -107986924, guid: 74a46d70302148f4197970af237056d0, type: 3}
    backgroundSprite: {fileID: 0}
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u5BF9\u4E0D\u8D77\u3002\u4E00\u5207\u90FD\u662F\u6211\u7684\u9519\u3002\u5373\u4F7F\u5728\u8FD9\u6837\u7684\u65F6\u523B\u4F9D\u7136\u505A\u4E0D\u5230\u627F\u62C5\u8D23\u4EFB\uFF0C\u628A\u672A\u6765\u53EF\u80FD\u7684\u7F6A\u884C\u548C\u6307\u8D23\u53C8\u63A8\u5378\u7ED9\u4E86\u4F60\u3002"
