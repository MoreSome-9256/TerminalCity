--- !u!114 &708100206133579056
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8999047924401375529}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b707fc30a207ee24ca4606a78147ec30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  onPointEnter:
    m_PersistentCalls:
      m_Calls: []
  onPointExit:
    m_PersistentCalls:
      m_Calls: []
  textComp: {fileID: 313596151573892226}
  lines:
  - text: ">>> \u8BA9\u672C\u623F\u95F4\uFF08\u7EC8\u7AEF\u6240\u5728\u7684B18\u4E2D\u63A7\u5BA4\uFF09\u7684\u5E94\u6025\u706F\u4EAE\u5EA6\u63D0\u9AD8\u767E\u5206\u4E4B\u5341"
    clearBefore: 0
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 1
  - text: ">>> \u786E\u5B9A\u6267\u884C\uFF1F(y/n)"
    clearBefore: 0
    waitForKey: 1
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u6307\u4EE4\u63A5\u6536\uFF1A \u8BA9\u672C\u623F\u95F4\uFF08\u7EC8\u7AEF\u6240\u5728\u7684B18\u4E2D\u63A7\u5BA4\uFF09\u7684\u5E94\u6025\u706F\u4EAE\u5EA6\u63D0\u9AD8\u767E\u5206\u4E4B\u5341\u3002"
    clearBefore: 1
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u6307\u4EE4\u6765\u6E90\u5206\u6790\u4E2D\u2026\u2026"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u8B66\u544A\uFF1A\u68C0\u6D4B\u5230\u6F5C\u5728\u7684\u591A\u610F\u8BC6\u4F53\u5E72\u6D89\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u6307\u4EE4\u903B\u8F91\u8FFD\u6EAF\uFF1A"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> - \u8F93\u5165\u8005\u5728\u8F93\u5165\u524D\uFF0C\u4E0E\u53E6\u4E00\u72EC\u7ACB\u610F\u8BC6\u4F53\u5B58\u5728\u660E\u786E\u7684\u8BED\u8A00\u4EA4\u6D41\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> - \u6700\u7EC8\u8F93\u5165\u5185\u5BB9\uFF08\u201C\u8BA9\u672C\u623F\u95F4\uFF08\u7EC8\u7AEF\u6240\u5728\u7684B18\u4E2D\u63A7\u5BA4\uFF09\u7684\u5E94\u6025\u706F\u4EAE\u5EA6\u63D0\u9AD8\u767E\u5206\u4E4B\u5341\u201D\uFF09\u4E0E\u53E6\u4E00\u610F\u8BC6\u4F53\u7684\u63D0\u8BAE\uFF08\u201C\u8BA9\u8FD9\u4E2A\u623F\u95F4\u7684\u5E94\u6025\u706F\u4EAE\u5EA6\u63D0\u9AD8\u767E\u5206\u4E4B\u5341\u201D\uFF09\u8BED\u4E49\u91CD\u5408\u5EA6
      > 95%\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u5224\u5B9A\uFF1A\u8BE5\u6307\u4EE4\u5E76\u975E\u6E90\u81EA\u5355\u4E00\u7528\u6237\u7684\u72EC\u7ACB\u610F\u5FD7\uFF0C\u800C\u662F\u7ECF\u7531\u5916\u90E8\u610F\u8BC6\u4F53\u63D0\u793A\u3001\u7528\u6237\u91C7\u7EB3\u540E\u5F62\u6210\u3002\u5B58\u5728\u201C\u96C6\u4F53\u610F\u56FE\u6C61\u67D3\u201D\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u6839\u636E\u6838\u5FC3\u534F\u8BAE\u7B2C\u4E00\u6761\uFF08\u7528\u6237\u5FC5\u987B\u4E3A\u5355\u4E00\u610F\u8BC6\u4E2A\u4F53\uFF09\uFF0C\u672C\u6307\u4EE4\u4E0D\u4E88\u6267\u884C\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u8BF7\u6839\u636E\u4F7F\u7528\u534F\u8BAE\u91CD\u65B0\u8F93\u5165\u6D4B\u8BD5\u6307\u4EE4\uFF1A"
    clearBefore: 1
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: '>>> '
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  charInterval: 0.05
  postLineDelay: 0.5
  typingAudioSource: {fileID: 8151999446304341072}
  typingClip: {fileID: 8300000, guid: 894e731553596f141ba469ac6cc59e01, type: 3}
