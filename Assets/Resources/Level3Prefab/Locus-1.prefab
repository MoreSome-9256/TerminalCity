  dialogueSequence:
  - speaker: 1
    charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u6211\u4EEC\u5FC5\u987B\u5C01\u5B58\u5B83\u3002\u6C38\u8FDC\u3002"
