--- !u!114 &4132466443351720181
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 377196628840769221}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b707fc30a207ee24ca4606a78147ec30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  onPointEnter:
    m_PersistentCalls:
      m_Calls: []
  onPointExit:
    m_PersistentCalls:
      m_Calls: []
  textComp: {fileID: 313596151573892226}
  lines:
  - text: ">>> \u6B63\u5728\u68C0\u6D4B\u7528\u6237\u6743\u9650..."
    clearBefore: 1
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u6743\u9650\uFF1A\u8BBF\u5BA2\uFF08\u65E0\u67E5\u770B\u7CFB\u7EDF\u6743\u9650\uFF09"
    clearBefore: 0
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u662F\u5426\u9605\u8BFB\u5F15\u5BFC\u6559\u7A0B\uFF1F(y/n)"
    clearBefore: 0
    waitForKey: 1
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u7B2C\u4E00\u6B65\uFF1A\u4E86\u89E3\u672C\u7CFB\u7EDF"
    clearBefore: 1
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u672C\u7CFB\u7EDF\u4E3ATeraCity\u7684\u4E2D\u592E\u63A7\u5236\u4E0E\u73B0\u5B9E\u534F\u8C03\u88C5\u7F6E\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u529F\u80FD\uFF1A\u901A\u8FC7\u63A5\u6536\u5E76\u6267\u884C\u552F\u4E00\u7528\u6237\uFF08User\uFF09\u7684\u6307\u4EE4\uFF0C\u4EE5\u6700\u5C0F\u73B0\u5B9E\u6270\u52A8\u65B9\u5F0F\u7EF4\u6301\u6216\u8C03\u6574\u57CE\u5E02\u8FD0\u884C\u72B6\u6001\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u6838\u5FC3\u7EA6\u675F\uFF1A\u7528\u6237\u5FC5\u987B\u4E3A\u5355\u4E00\u610F\u8BC6\u4E2A\u4F53\u3002\u96C6\u4F53\u51B3\u7B56\u3001\u6C11\u4E3B\u6295\u7968\u7B49\u7FA4\u4F53\u610F\u8BC6\u6307\u4EE4\u65E0\u6548\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 
    simulateUserTyping: 0
  - text: ">>> \u662F\u5426\u786E\u8BA4\uFF1F(y/n)"
    clearBefore: 0
    waitForKey: 1
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u7B2C\u4E8C\u6B65\uFF1A\u6743\u9650\u4E0E\u4EE3\u4EF7"
    clearBefore: 1
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u7528\u6237\u6743\u9650\u8D4B\u4E88\u540E\uFF0C\u5C06\u89E6\u53D1\u4EE5\u4E0B\u4E0D\u53EF\u9006\u6548\u679C\uFF1A"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> 1. \u7528\u6237\u751F\u7406\u72B6\u6001\u9501\u5B9A\uFF08\u505C\u6B62\u8870\u8001\uFF0C\u514D\u75AB\u591A\u6570\u75BE\u75C5\uFF0C\u76F4\u81F3\u6743\u9650\u89E3\u9664\u6216\u6B7B\u4EA1\uFF09\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> 2. \u7528\u6237\u6307\u4EE4\u4E3A\u6700\u9AD8\u4F18\u5148\u7EA7\uFF0C\u7CFB\u7EDF\u5C06\u65E0\u89C6\u5176\u4ED6\u4E00\u5207\u5916\u90E8\u903B\u8F91\u51B2\u7A81\uFF0C\u4EE5\u201C\u5B9E\u73B0\u6307\u4EE4\u201D\u4E3A\u552F\u4E00\u76EE\u6807\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u8B66\u544A\uFF1A\u6743\u9650\u8D4B\u4E88\u540E\uFF0C\u7528\u6237\u5C06\u6210\u4E3A\u7CFB\u7EDF\u7684\u552F\u4E00\u63A5\u53E3\u3002\u57CE\u5E02\u7684\u5B89\u5168\u4E0E\u5B58\u7EED\u5C06\u9AD8\u5EA6\u4F9D\u8D56\u7528\u6237\u4E2A\u4F53\u7684\u5224\u65AD\u4E0E\u7A33\u5B9A\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u5DF2\u77E5\u6653\uFF0C\u7EE7\u7EED\uFF08y/n\uFF09"
    clearBefore: 0
    waitForKey: 1
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u7B2C\u4E09\u6B65\uFF1A\u6307\u4EE4\u8F93\u5165\u6F14\u793A"
    clearBefore: 1
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u672C\u7CFB\u7EDF\u6267\u884C\u6307\u4EE4\u7684\u6838\u5FC3\u539F\u5219\uFF1A\u4EE5\u6700\u5C0F\u5E45\u5EA6\u5E72\u6D89\u73B0\u5B9E\u56E0\u679C\u94FE\uFF0C\u5B9E\u73B0\u7528\u6237\u610F\u56FE\u3002"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: ">>> \u8BF7\u8F93\u5165\u4E00\u6761\u6D4B\u8BD5\u6307\u4EE4\u4EE5\u7406\u89E3\u7CFB\u7EDF\u8FD0\u4F5C\u65B9\u5F0F\uFF1A"
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  - text: '>>> '
    clearBefore: 0
    waitForKey: 0
    validKeys: 79000000
    simulateUserTyping: 0
  charInterval: 0.05
  postLineDelay: 0.5
  typingAudioSource: {fileID: 4714798897728995388}
  typingClip: {fileID: 8300000, guid: 894e731553596f141ba469ac6cc59e01, type: 3}
