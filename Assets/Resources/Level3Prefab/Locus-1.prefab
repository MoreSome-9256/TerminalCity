--- !u!114 &1051932222030324299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7408167594431262944}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50defcfea6479224f8ed80a2121ce4db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  thisObject: {fileID: 7408167594431262944}
  backgroundImage: {fileID: 706269562255255045}
  charNameText: {fileID: 2312452147453596148}
  dialogueText: {fileID: 1591057118840255297}
  characterImage: {fileID: 677185439610448663}
  nextButton: {fileID: 3541487310836137184}
  dialogueSequence:
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u4ED6\u8BF4\u2026\u2026\u662F\u4ED6\u81EA\u5DF1\u5199\u5B8C\u5C31\u53D1\u4E86\u3002\u201C\u60F3\u7740\u6211\u4EEC\u5E94\u8BE5\u9700\u8981\u201D\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: a746b42bf8575e94c88639505b36a35b, type: 3}
  - charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u2026\u2026\u201C\u4EE5\u7B26\u5408\u73B0\u5B9E\u903B\u8F91\u7684\u65B9\u5F0F\u201D\u3002\u8FD9\u5C31\u662F\u5B83\u7684\u65B9\u5F0F\u3002\u5B83\u6CA1\u6709\u521B\u9020\u62A5\u544A\uFF0C\u6CA1\u6709\u7BE1\u6539\u6570\u636E\uFF0C\u751A\u81F3\u6CA1\u6709\u76F4\u63A5\u7ED9\u6234\u5229\u514B\u53D1\u9001\u4EFB\u4F55\u6307\u4EE4\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u5B83\u53EA\u662F\u2026\u2026\u5728\u67D0\u4E2A\u6211\u4EEC\u770B\u4E0D\u89C1\u7684\u5C42\u9762\uFF0C<b>\u8BA9\u2018\u6234\u5229\u514B\u5728\u6B64\u65F6\u6B64\u523B\u5B8C\u6210\u5E76\u53D1\u9001\u62A5\u544A\u2019\u8FD9\u4E2A\u5FF5\u5934\uFF0C\u6210\u4E3A\u4ED6\u6240\u6709\u53EF\u80FD\u5FF5\u5934\u4E2D\u2018\u6700\u81EA\u7136\u2019\u3001\u2018\u6700\u5408\u7406\u2019\u7684\u90A3\u4E00\u4E2A</b>\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u6240\u4EE5\uFF0C\u6234\u5229\u514B\u4F9D\u7136\u8BA4\u4E3A\u90A3\u662F\u4ED6\u81EA\u5DF1\u7684\u51B3\u5B9A\u3002\u4ED6\u4F9D\u7136\u662F\u201C\u81EA\u7531\u201D\u7684\u3002\u53EA\u662F\u4ED6\u81EA\u7531\u7684\u8FB9\u754C\u2026\u2026\u88AB\u8F7B\u8F7B\u5730\u63A8\u4E86\u4E00\u4E0B\u3002\u671D\u7740\u7EC8\u7AEF\u60F3\u8981\u7684\u65B9\u5411\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u7F57\u5C14\uFF0C\u4F0A\u8299\u7433\u5931\u63A7\u7684\u65F6\u5019\u2026\u2026\u90A3\u79CD\u611F\u89C9\u4F60\u8FD8\u8BB0\u5F97\u5417\uFF1F\u4E0D\u662F\u7206\u70B8\uFF0C\u4E0D\u662F\u51B2\u51FB\uFF0C\u662F\u201C\u73B0\u5B9E\u201D\u672C\u8EAB\u5728\u4F60\u773C\u524D\u88AB\u6495\u5F00\u3001\u63C9\u788E\u3001\u91CD\u5199\u3002\u800C\u73B0\u5728\u2026\u2026"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u2026\u2026\u8FD9\u4E2A\u4E1C\u897F\uFF0C\u5B83\u81EA\u79F0\u7528\u201C\u6700\u5C0F\u6270\u52A8\u201D\u5DE5\u4F5C\u3002\u4F46\u201C\u6700\u5C0F\u201D\u662F\u76F8\u5BF9\u4EC0\u4E48\u800C\u8A00\u7684\uFF1F\u5BF9\u4E00\u4EFD\u62A5\u544A\u6765\u8BF4\u662F\u201C\u6700\u5C0F\u201D\uFF0C\u90A3\u5982\u679C\u6307\u4EE4\u662F\u201C\u8BA9TC\u6C38\u8FDC\u5B89\u5168\u201D\u5462\uFF1F\u201C\u8BA9\u6240\u6709\u4EBA\u4E0D\u518D\u75DB\u82E6\u201D\u5462\uFF1F"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u6D1B\u5E93\u65AF/Locus"
    dialogueText: "\u5B83\u8981\u201C\u6270\u52A8\u201D\u591A\u5C11\u6982\u7387\uFF0C\u626D\u66F2\u591A\u5C11\u56E0\u679C\uFF0C\u624D\u80FD\u5B9E\u73B0\u8FD9\u79CD\u89C4\u6A21\u7684\u201C\u610F\u56FE\u201D\uFF1F\u5B83\u4F1A\u4E0D\u4F1A\u2026\u2026\u5728\u67D0\u4E2A\u6211\u4EEC\u65E0\u6CD5\u9884\u77E5\u7684\u4E34\u754C\u70B9\uFF0C\u50CF\u4F0A\u8299\u7433\u7684\u80FD\u529B\u4E00\u6837\uFF0C\u628A\u73B0\u5B9E\u7684\u7ED3\u6784\u5F7B\u5E95\u62C9\u65AD\uFF1F"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: "\u7F57\u5948\u5C14\u5FB7/Ronald"
    dialogueText: "\u2026\u2026"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  typingSpeed: 0.05
  backgroundTransition: {fileID: 0}
