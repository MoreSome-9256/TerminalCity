  segments:
  - officialLine: "\u540C\u80DE\u4EEC\uFF1A"
    hasChoices: 0
    options: []
  - officialLine: "\u4ECA\u5929\u80FD\u591F\u76F8\u805A\u5728\u8FD9\u91CC\uFF0C\u6211\u76F8\u4FE1\u5BF9\u5728\u573A\u7684\u6240\u6709\u4EBA\u6765\u8BF4\uFF0C\u65E2\u662F\u83AB\u5927\u7684\u5E78\u8FD0\uFF0C\u53C8\u662F\u96BE\u4EE5\u8A00\u55BB\u7684\u60B2\u4F24\u3002"
    hasChoices: 0
    options: []
  - officialLine: "20\u5929\u524D\uFF0C\u707E\u96BE\u5E2D\u5377\u4E86\u8FD9\u9897\u661F\u7403\u3002\u6211\u4EEC\u7ECF\u5386\u7684\uFF0C\u8FDC\u8FDC\u4E0D\u6B62\u4EBF\u4E07\u4EBA\u7684\u727A\u7272\u4E0E\u6587\u660E\u7684\u574D\u584C\u2014\u2014\u751F\u547D\u7684\u6D88\u901D\uFF0C\u4ECE\u6765\u4E0D\u5B58\u5728\u6570\u91CF\u4E4B\u522B\uFF1B\u6BCF\u4E00\u4E2A\u9047\u96BE\u8005\uFF0C\u90FD\u662F\u4EBA\u7C7B\u6587\u660E\u4E0D\u53EF\u627F\u53D7\u4E4B\u91CD\u3002"
    hasChoices: 0
    options: []
  - officialLine: "\u5F53\u6211\u770B\u5230\u4F60\u4EEC\u9762\u5E9E\u4E0A\u7684\u60B2\u75DB\u4E0E\u773C\u7738\u4E2D\u7684\u7EDD\u671B\uFF0C\u81EA\u5DF1\u7684\u5185\u5FC3\u4E5F\u5728\u6DF1\u6DF1\u5171\u9E23\uFF1A"
    hasChoices: 0
    options: []
  - officialLine: "\u6211\u7684\u59BB\u5B50\u548C\u5973\u513F\uFF0C\u540C\u6837\u5728\u8FD9\u573A\u707E\u96BE\u4E2D\u53BB\u4E16\u4E86\u3002\u9664\u6B64\u4E4B\u5916\uFF0C\u79BB\u5F00\u6211\u4EEC\u7684\u8FD8\u6709\u5353\u8D8A\u7684\u5EFA\u7B51\u5E08\uFF0CTC\u7684\u8BBE\u8BA1\u8005\u827E\u745E\u4E1D\uFF1BTC\u4E2D\u592E\u653F\u5E9C\u7684\u5F88\u591A\u4EBA\u4E5F\u90FD\u627F\u53D7\u7740\u4E27\u5931\u81F3\u4EB2\u4E4B\u75DB\u3002"
    hasChoices: 1
    options:
    - ">> \u6211\u7684\u59BB\u5B50\u548C\u5973\u513F\uFF0C\u540C\u6837\u5728\u8FD9\u573A\u707E\u96BE\u4E2D\u53BB\u4E16\u4E86\u3002\u9664\u6B64\u4E4B\u5916\uFF0C\u79BB\u5F00\u6211\u4EEC\u7684\u8FD8\u6709\u5353\u8D8A\u7684\u5EFA\u7B51\u5E08\uFF0CTC\u7684\u8BBE\u8BA1\u8005\u827E\u745E\u4E1D\uFF1BTC\u4E2D\u592E\u653F\u5E9C\u7684\u5F88\u591A\u4EBA\u4E5F\u90FD\u627F\u53D7\u7740\u4E27\u5931\u81F3\u4EB2\u4E4B\u75DB\u3002"
    - ">> \u827E\u8299\u6839\u672C\u5C31\u4E0D\u662F\u6B7B\u4E8E\u8FD9\u573A\u707E\u96BE\u2026\u2026\u5728\u6B64\u4E4B\u524D\u5979\u5C31\u88AB\u6211\u5BB3\u6B7B\u4E86\u3002\u514B\u52B3\u8FEA\u5A05\u548CIris\u7684\u6B7B\u4E5F\u662F\u56E0\u4E3A\u6211\u2026\u2026\u800C\u6211\u73B0\u5728\u5374\u7AD9\u5728\u8FD9\u91CC\uFF0C\u7528\u8C0E\u8A00\u7F16\u7EC7\u865A\u5047\u7684\u5E0C\u671B\u3002"
    - ">> \u6211\u60F3\u544A\u8BC9\u4F60\u4EEC\u7684\u662F\uFF1A\u5BB3\u6B7B\u6211\u5973\u513F\u7684\uFF0C\u662F\u6211\u81EA\u5DF1\u3002\u5BB3\u6B7B\u827E\u745E\u4E1D\u7684\uFF0C\u662F\u6211\u3002\u5BB3\u6B7B\u4F60\u4EEC\u6240\u6709\u4EBA\u7684\uFF0C\u8FD8\u662F\u6211\u3002"
  - officialLine: "\u540C\u80DE\u4EEC\uFF0C\u6211\u4E4B\u6240\u4EE5\u8FD9\u6837\u8BF4\uFF0C\u662F\u60F3\u544A\u8BC9\u5927\u5BB6\uFF0C\u5728\u8FD9\u6837\u7684\u707E\u96BE\u9762\u524D\uFF0C\u4F60\u6211\u5DF2\u65E0\u8EAB\u4EFD\u4E4B\u522B\uFF1A"
    hasChoices: 1
    options:
    - ">> \u540C\u80DE\u4EEC\uFF0C\u6211\u4E4B\u6240\u4EE5\u8FD9\u6837\u8BF4\uFF0C\u662F\u60F3\u544A\u8BC9\u5927\u5BB6\uFF0C\u5728\u8FD9\u6837\u7684\u707E\u96BE\u9762\u524D\uFF0C\u4F60\u6211\u5DF2\u65E0\u8EAB\u4EFD\u4E4B\u522B\uFF1A"
    - ">> \u6211\u662F\u5BFC\u81F4\u8FD9\u4E00\u5207\u7684\u7F6A\u9B41\u7978\u9996\u3002\u6211\u6709\u4EC0\u4E48\u8D44\u683C\u8BF4\u81EA\u5DF1\u548C\u4F60\u4EEC\u8FD9\u4E9B\u65E0\u8F9C\u7684\u53D7\u5BB3\u8005\u201C\u6CA1\u6709\u8EAB\u4EFD\u4E4B\u522B\u201D\uFF1F"
    - ">> \u4F60\u4EEC\u662F\u53D7\u5BB3\u8005\u3002\u6211\u4E0D\u662F\u3002\u6211\u4E0D\u914D\u548C\u4F60\u4EEC\u7AD9\u5728\u4E00\u8D77\u3002"
  - officialLine: "\u65E0\u8BBA\u662F\u5171\u5B58\u6D3E\u3001\u6D88\u706D\u6D3E\uFF0C\u8FD8\u662F\u90A3\u4E9B\u4ECE\u672A\u53C2\u4E0E\u7EB7\u4E89\u5374\u540C\u6837\u6DF1\u53D7\u4F24\u5BB3\u7684\u4EBA\u4EEC\uFF0C\u6B64\u523B\u7684\u6211\u4EEC\uFF0C\u90FD\u53EA\u662F\u4E3A\u540C\u4E00\u4E2A\u901D\u53BB\u7684\u4E16\u754C\u9ED8\u54C0\u7684\u666E\u901A\u4EBA\u2014\u2014\u6DF1\u6E0A\u4E4B\u4E0B\uFF0C\u4ECE\u65E0\u5E78\u5B58\u8005\u3002"
    hasChoices: 1
    options:
    - ">> \u65E0\u8BBA\u662F\u5171\u5B58\u6D3E\u3001\u6D88\u706D\u6D3E\uFF0C\u8FD8\u662F\u90A3\u4E9B\u4ECE\u672A\u53C2\u4E0E\u7EB7\u4E89\u5374\u540C\u6837\u6DF1\u53D7\u4F24\u5BB3\u7684\u4EBA\u4EEC\uFF0C\u6B64\u523B\u7684\u6211\u4EEC\uFF0C\u90FD\u53EA\u662F\u4E3A\u540C\u4E00\u4E2A\u901D\u53BB\u7684\u4E16\u754C\u9ED8\u54C0\u7684\u666E\u901A\u4EBA\u2014\u2014\u6DF1\u6E0A\u4E4B\u4E0B\uFF0C\u4ECE\u65E0\u5E78\u5B58\u8005\u3002"
    - ">> \u53EF\u4F60\u4EEC\u4E0D\u77E5\u9053\uFF0C\u771F\u6B63\u7684\u6DF1\u6E0A\uFF0C\u4E0D\u5728\u5916\u9762\uFF0C\u5728\u90A3\u4E9B\u4EB2\u624B\u5236\u9020\u707E\u96BE\u7684\u4EBA\u7684\u5FC3\u91CC\u3002\u800C\u6211\uFF0C\u5C31\u662F\u90A3\u4E2A\u6DF1\u6E0A\u3002"
    - ">> \u201C\u4ECE\u65E0\u5E78\u5B58\u8005\u201D\uFF1F\u90A3\u6211\u662F\u4EC0\u4E48\uFF1F\u4E00\u4E2A\u8FD8\u6CA1\u6B7B\u53BB\u7684\u7F6A\u4EBA\uFF0C\u7B97\u5E78\u5B58\u8005\u5417\uFF1F"
  - officialLine: "\u4F46\u4ECA\u5929\uFF0C\u6211\u4EEC\u805A\u96C6\u4E8E\u6B64\uFF0C\u4E0D\u4EC5\u4EC5\u662F\u4E3A\u4E86\u54C0\u60BC\uFF0C\u66F4\u662F\u4E3A\u4E86\u89C1\u8BC1\u4E00\u4E2A\u5947\u8FF9\u2014\u2014\u4E00\u4E2A\u7531\u7406\u6027\u3001\u52C7\u6C14\u3001\u4EE5\u53CA\u65E0\u6570\u4EBA\u96BE\u4EE5\u60F3\u8C61\u7684\u727A\u7272\u6240\u6362\u6765\u7684\u5947\u8FF9\u3002"
    hasChoices: 1
    options:
    - ">> \u4F46\u4ECA\u5929\uFF0C\u6211\u4EEC\u805A\u96C6\u4E8E\u6B64\uFF0C\u4E0D\u4EC5\u4EC5\u662F\u4E3A\u4E86\u54C0\u60BC\uFF0C\u66F4\u662F\u4E3A\u4E86\u89C1\u8BC1\u4E00\u4E2A\u5947\u8FF9\u2014\u2014\u4E00\u4E2A\u7531\u7406\u6027\u3001\u52C7\u6C14\u3001\u4EE5\u53CA\u65E0\u6570\u4EBA\u96BE\u4EE5\u60F3\u8C61\u7684\u727A\u7272\u6240\u6362\u6765\u7684\u5947\u8FF9\u3002"
    - ">> \u5982\u679C\u8FD9\u573A\u201C\u4F53\u73B0\u7406\u6027\u548C\u52C7\u6C14\u201D\u3001\u9020\u6210\u4E86\u65E0\u6570\u727A\u7272\u7684\u707E\u96BE\u672C\u4E0D\u5FC5\u53D1\u751F\uFF0C\u4F60\u4EEC\u8FD8\u4F1A\u89C9\u5F97\u73B0\u5728\u7684\u4E00\u5207\u662F\u6240\u8C13\u201C\u5947\u8FF9\u201D\u5417\uFF1F"
    - ">> \u6211\u7684\u624B\u5728\u6296\u3002\u4ECE\u4EC0\u4E48\u65F6\u5019\u5F00\u59CB\u7684\uFF1F\u6F14\u8BB2\u5F00\u59CB\u524D\uFF1F\u8FD8\u662F\u2026\u2026\u90A3\u4E4B\u540E\uFF1F\u4ECE\u827E\u8299\u6B7B\u7684\u90A3\u5929\u8D77\uFF0C\u5C31\u6CA1\u505C\u8FC7\u3002"
  - officialLine: "\u5F53\u707E\u96BE\u53D1\u751F\u65F6\uFF0C\u662F\u5EFA\u8BBE\u8005\u4EEC\u591C\u4EE5\u7EE7\u65E5\uFF0C\u5C06\u5EFA\u8BBE\u8FDB\u5EA6\u538B\u7F29\u81F3\u6781\u9650\uFF1B\u662F\u5FD7\u613F\u8005\u4EEC\u5192\u7740\u98CE\u9669\uFF0C\u7EF4\u62A4\u4E86\u64A4\u9000\u65F6\u7684\u79E9\u5E8F\uFF1B\u662F\u6BCF\u4E00\u4F4D\u516C\u6C11\uFF0C\u7528\u4F60\u4EEC\u7684\u7406\u89E3\u4E0E\u914D\u5408\uFF0C\u5171\u540C\u5B8C\u6210\u4E86\u8FD9\u573A\u770B\u4F3C\u4E0D\u53EF\u80FD\u7684\u7D27\u6025\u907F\u96BE\u3002"
    hasChoices: 1
    options:
    - ">> \u5F53\u707E\u96BE\u53D1\u751F\u65F6\uFF0C\u662F\u5EFA\u8BBE\u8005\u4EEC\u591C\u4EE5\u7EE7\u65E5\uFF0C\u5C06\u5EFA\u8BBE\u8FDB\u5EA6\u538B\u7F29\u81F3\u6781\u9650\uFF1B\u662F\u5FD7\u613F\u8005\u4EEC\u5192\u7740\u98CE\u9669\uFF0C\u7EF4\u62A4\u4E86\u64A4\u9000\u65F6\u7684\u79E9\u5E8F\uFF1B\u662F\u6BCF\u4E00\u4F4D\u516C\u6C11\uFF0C\u7528\u4F60\u4EEC\u7684\u7406\u89E3\u4E0E\u914D\u5408\uFF0C\u5171\u540C\u5B8C\u6210\u4E86\u8FD9\u573A\u770B\u4F3C\u4E0D\u53EF\u80FD\u7684\u7D27\u6025\u907F\u96BE\u3002"
    - ">> TC\u7684\u5EFA\u6210\u662F\u56E0\u4E3AIris\u7684\u81EA\u6740\uFF1B\u64A4\u9000\u65F6\u7684\u79E9\u5E8F\u2026\u2026\u662F\u56E0\u4E3A\u70B8\u6BC1\u4E86\u8DE8\u6D77\u5927\u6865\u3002\u65E0\u8BBA\u662F\u80FD\u529B\u8FD8\u662F\u4F26\u7406\u2026\u2026\u90FD\u5DF2\u7ECF\u53D8\u6210\u6211\u4EEC\u65E0\u6CD5\u7406\u89E3\u7684\u4E8B\u60C5\u3002"
    - ">> \u5982\u679C\u4ED6\u4EEC\u77E5\u9053\u4E86\u90A3\u573A\u516C\u6295\u7684\u7ED3\u679C\uFF0C\u4F1A\u600E\u4E48\u60F3\uFF1F\u600E\u4E48\u53EF\u80FD\u7406\u89E3\u201C\u70B8\u6BC1\u5927\u6865\u201D\u90A3\u4E2A\u51B3\u5B9A\uFF1F"
  - officialLine: "TeraCity\u7684\u5EFA\u6210\uFF0C\u5E76\u975E\u4E0A\u5929\u7684\u9988\u8D60\u3002\u5B83\u662F\u6211\u4EEC\u4EBA\u7C7B\u4EB2\u624B\u521B\u9020\u7684\u5947\u8FF9\u3002\u5B83\u8BC1\u660E\u4E86\u4E00\u4EF6\u4E8B\uFF1A\u54EA\u6015\u9762\u5BF9\u6700\u6DF1\u7684\u7EDD\u671B\uFF0C\u6211\u4EEC\u4F9D\u7136\u80FD\u591F\u7D27\u63E1\u5E0C\u671B\u7684\u706B\u79CD\u3002"
    hasChoices: 1
    options:
    - ">> TeraCity\u7684\u5EFA\u6210\uFF0C\u5E76\u975E\u4E0A\u5929\u7684\u9988\u8D60\u3002\u5B83\u662F\u6211\u4EEC\u4EBA\u7C7B\u4EB2\u624B\u521B\u9020\u7684\u5947\u8FF9\u3002\u5B83\u8BC1\u660E\u4E86\u4E00\u4EF6\u4E8B\uFF1A\u54EA\u6015\u9762\u5BF9\u6700\u6DF1\u7684\u7EDD\u671B\uFF0C\u6211\u4EEC\u4F9D\u7136\u80FD\u591F\u7D27\u63E1\u5E0C\u671B\u7684\u706B\u79CD\u3002"
