--- !u!114 &5855635801365776232
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9196622809827793528}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50defcfea6479224f8ed80a2121ce4db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  thisObject: {fileID: 6725731749795479577}
  backgroundImage: {fileID: 7317823061797688098}
  charNameText: {fileID: 4314242734115855798}
  dialogueText: {fileID: 4544305041477225142}
  characterImage: {fileID: 2021185215725619125}
  nextButton: {fileID: 5826381019301588796}
  dialogueSequence:
  - charName: 
    dialogueText: "\u5706\u5468\u7387\u3002\u03C0\u3002\u65E0\u9650\u7684\u8C61\u5F81\uFF0C\u65E0\u59CB\u65E0\u7EC8\u7684\u6DF1\u6E0A\uFF0C\u5E73\u6ED1\uFF0C\u8FDE\u7EED\uFF0C\u4E0D\u53EF\u4FB5\u72AF\u7684\u5B87\u5B99\u795E\u6027\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u4F46\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\uFF0C\u5982\u679C\u5706\u5468\u7387\u662F\u6709\u9650\u7684\u5462\uFF1F"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u5047\u5982\u5728\u67D0\u4E2A\u65E0\u4EBA\u5F97\u77E5\u7684\u7CBE\u5EA6\u672B\u7AEF\uFF0C\u6F2B\u957F\u65E0\u5E8F\u7684\u6570\u5B57\u7A81\u7136\u8DCC\u5165\u6B7B\u5BC2\uFF0C\u4F59\u6570\u5F52\u96F6\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u90A3\u53EA\u610F\u5473\u7740\u4E00\u4EF6\u4E8B\uFF1A\u8FD9\u4E2A\u88AB\u6211\u4EEC\u79F0\u4F5C\u201C\u73B0\u5B9E\u201D\u7684\u5E9E\u5927\u5BB9\u5668\uFF0C\u5E95\u5C42\u4E0D\u8FC7\u8FD0\u884C\u7740\u4E00\u4E2A\u6E32\u67D3\u5F15\u64CE\u3002\u7B97\u529B\u5728\u6B64\u622A\u65AD\uFF0C\u6D6E\u70B9\u8FBE\u5230\u4E0A\u9650\uFF0C\u82CD\u7A79\u7684\u8FB9\u7F18\u6253\u4E0A\u4E86\u4E00\u5C42\u4E3A\u4E86\u9632\u6B62\u6EA2\u51FA\u800C\u7C97\u66B4\u7F1D\u5408\u7684\u8865\u4E01\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u4F46\u73B0\u5B9E\u4E2D\uFF0C\u6216\u8005\u8BF4\u6211\u4EEC\u4EE5\u4E3A\u7684\u73B0\u5B9E\u4E2D\uFF0C\u4ECE\u6765\u5C31\u6CA1\u6709\u4EC0\u4E48\u5B8C\u7F8E\u7684\u5706\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u65E0\u8BBA\u4F60\u7528\u7EB3\u7C73\u5149\u523B\u673A\u523B\u8680\u4E00\u4E2A\u5706\uFF0C\u8FD8\u662F\u770B\u4E00\u4E2A\u6C34\u6EF4\uFF0C\u653E\u5927\u5230\u539F\u5B50\u5C3A\u5EA6\uFF0C\u5B83\u4EEC\u90FD\u662F\u7531\u79BB\u6563\u7684\u539F\u5B50\u3001\u5938\u514B\u548C\u7535\u5B50\u6784\u6210\u7684\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u5206\u5B50\u662F\u50CF\u7D20\u3002\u539F\u5B50\u662F\u50CF\u7D20\u3002\u5B87\u5B99\u662F\u4E00\u53F0\u62D9\u52A3\u7684\u663E\u793A\u5668\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u7136\u800C\u4EBA\u7C7B\u7684\u773C\u775B\uFF0C\u5206\u4E0D\u6E05\u4E00\u4E07\u8FB9\u5F62\u548C\u5706\u3002\u4F60\u89C9\u5F97\u5B83\u662F\u5706\u7684\uFF0C\u4F60\u89C9\u5F97\u4E16\u754C\u662F\u5149\u6ED1\u7684\uFF0C\u8FDE\u7EED\u7684\uFF0C\u771F\u5B9E\u7684\u3002\r"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u6240\u4EE5\uFF0C\u865A\u62DF\u4E0E\u73B0\u5B9E\u7684\u533A\u522B\u662F\u4EC0\u4E48\uFF1F\r"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u4E0D\u8FC7\u662F3.14\u4E0E\u03C0\uFF0C\u4E0D\u8FC7\u662F int
      \u4E0E double\u3002\r"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u53EF\u60B2\u7684\u662F\uFF0C\u6211\u4EEC\u65E9\u5DF2\u4E60\u60EF\u5C06\u90A3\u4E2A\u88AB\u64C5\u81EA\u56DB\u820D\u4E94\u5165\u76843.14\u4EE3\u5165\u6240\u6709\u7684\u5B9A\u5F8B\u4E0E\u65E5\u5E38\u3002\u6211\u4EEC\u5728\u88AB\u9609\u5272\u7684\u516C\u5F0F\u91CC\u6784\u5EFA\u6587\u660E\uFF0C\u7528\u6CE8\u5B9A\u6F02\u79FB\u7684\u8BEF\u5DEE\u8BA1\u7B97\u672A\u6765\uFF0C\u751A\u81F3\u7406\u6240\u5F53\u7136\u5730\u628A\u5931\u771F\u7684\u6B8B\u6E23\uFF0C\u5949\u4E3A\u575A\u4E0D\u53EF\u6467\u7684\u771F\u7406\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u5728\u6709\u9650\u7684\u5706\u5468\u7387\u4E2D\uFF0C\u3010\u9006\u6052\u3011\u8BDE\u751F\u4E86\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u90A3\u662F\u591A\u8FB9\u5F62\u4E0E\u5706\u8BA1\u7B97\u7684\u8BEF\u5DEE\uFF0C\u662F\u8BA4\u77E5\u4E0E\u5B9E\u9645\u4E4B\u95F4\u7684\u88C2\u9699\uFF0C\u662F\u4F2A\u88C5\u7684\u53F0\u524D\u4E0E\u5D29\u89E3\u7684\u5E55\u540E\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - charName: 
    dialogueText: "\u662F\u6C89\u6EBA\u4E8E\u5047\u8C61\u7684\u8BA4\u77E5\u71B5\uFF0C\u4E0E\u90A3\u67C4\u7EC8\u5C06\u5207\u65AD\u6240\u6709\u62DF\u5408\u66F2\u7EBF\u7684\uFF0C\u5B9E\u9006\u6052\u3002"
    characterSprite: {fileID: 0}
    backgroundSprite: {fileID: 0}
